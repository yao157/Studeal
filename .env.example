# Скопіюй у ".env" і підстав свої значення.
# Усі ключі з префіксом DB__/BOT__/REDIS__ (див. config/config.py).
#
# Локально без Docker: підніми Postgres сам і залиш DB__HOST=localhost.
# Увесь стек (Postgres + Task Bot): скопіюй цей файл у `.env`, заповни BOT__,
# потім `docker compose up -d --build` (у контейнері DB__HOST підставиться сам).

DB__HOST=localhost
DB__PORT=5432
DB__USER=studeal
DB__PASSWORD=secret
DB__NAME=studeal_db

BOT__TOKEN_MAIN=123456:ABCDEF...
BOT__TOKEN_TASK=123456:ABCDEF...
BOT__ADMIN_IDS=[123456789]
BOT__CHANNEL_ID=-1001234567890

# Опційно (є значення за замовчуванням):
# REDIS__HOST=localhost
# REDIS__PORT=6379
